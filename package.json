{
  "name": "oh-my-immersive",
  "version": "1.0.0",
  "description": "Hide unrelated folders while presenting, arrange files and folders by dragging, and annotate the current window from a browser on your local network.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint src",
    "test": "node --test tests/*.test.mjs",
    "sync": "node sync.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "author": {
    "name": "volmodaoist",
    "email": "1304548501@qq.com",
    "url": "https://github.com/volmodaoist"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0"
  },
  "homepage": "https://github.com/volmodaoist/Oh-My-Immersive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volmodaoist/Oh-My-Immersive.git"
  },
